# Copy to .env.local (gitignored) to override — the real default (see
# src/api/config.ts) already derives from window.location.hostname, not a
# hardcoded "localhost", which is what lets a second person on the same
# LAN join a page for local testing (open http://<host's-LAN-IP>:5173/pages/<id>
# instead of localhost — vite.config.ts's server.host binds all
# interfaces for exactly this). Set these only to point at a backend on a
# different host/port than that default assumes.
VITE_GATEWAY_URL=http://localhost:8000
VITE_COLLAB_URL=http://localhost:8002
VITE_NOTIFICATIONS_URL=http://localhost:8007
