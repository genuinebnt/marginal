# Serves the built SPA inside the marginal stack. The public gateway proxies
# here for everything that is not an API prefix, so this file deliberately
# knows nothing about TLS, domains, or the backend services.
:80 {
	root * /srv
	encode gzip zstd

	# Hashed by Vite, so they can be cached forever.
	@immutable path /assets/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	# The wasm modules are served from public/, so Vite does not hash their
	# names — a rebuild changes the bytes behind a stable URL. That forced a
	# five-minute max-age, which meant every visitor re-downloaded about a
	# megabyte per module every five minutes, on every screen that used one.
	# Nine modules. That is what "the app is very slow" turned out to be:
	# not the server, which sits at 0% CPU, but the cache expiring constantly.
	#
	# The lasting fix, now applied: the loaders append ?v=<build id>, so each
	# deploy asks for a URL nothing has ever cached — which is exactly the
	# condition `immutable` requires. Same trick Vite applies to /assets/* by
	# hashing filenames; this is the query-string version, for files it does
	# not own. See web/src/wasm-url.ts.
	@wasm path *.wasm
	header @wasm Cache-Control "public, max-age=31536000, immutable"

	# index.html must NEVER be cached, and this is not a tuning knob.
	#
	# It carried no Cache-Control at all, so browsers applied heuristic
	# caching to it — and it is the one file that names which hashed bundle
	# to load. A stale index.html therefore pins a visitor to the PREVIOUS
	# deploy's /assets/index-<hash>.js, which is served `immutable` for a
	# year and will never be revalidated. The result is a browser that
	# cannot leave the old app no matter how many times the site is
	# rebuilt: exactly the "the new screens still aren't there" report that
	# found this.
	#
	# The pairing is the point — immutable assets are only safe when the
	# document that names them is always fresh.
	@html path / /index.html
	header @html Cache-Control "no-cache, must-revalidate"

	# Client-side routing: unknown paths are SPA routes, not 404s. Those
	# responses ARE index.html, so they need the same treatment.
	@spa not path /assets/* *.wasm *.js *.css *.svg *.png *.woff2
	header @spa Cache-Control "no-cache, must-revalidate"

	try_files {path} /index.html
	file_server
}
