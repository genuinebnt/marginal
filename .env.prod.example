# Copy to .env on the VPS and fill in. Never commit the filled-in copy.
#
# Generate the four passwords with:
#   for v in DOC AUTH COLLAB NOTIFICATION; do
#     echo "${v}_DB_PASSWORD=$(openssl rand -base64 24 | tr -d /+= )"
#   done

# The origin the SPA is served from. Baked into the JS bundle at image build
# time and used for the CORS and WebSocket-origin allowlists, so changing it
# means rebuilding the web image, not just restarting.
PUBLIC_ORIGIN=https://marginal.genuinebasil.dev

DOC_DB_PASSWORD=
AUTH_DB_PASSWORD=
COLLAB_DB_PASSWORD=
NOTIFICATION_DB_PASSWORD=
